// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

model User {
  id             String                @id @default(uuid())
  email          String                @unique
  emailVerified  Boolean               @default(false)
  hashedPassword String?
  firstName      String?
  lastName       String?
  avatar         String?
  role           Role                  @default(USER)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  Session        RefreshTokenSession[]

  @@index([email])
  @@map("users")
}

model RefreshTokenSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blacklisted Boolean  @default(false)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, blacklisted, expiresAt])
  @@index([token])
  @@map("refresh_token_sessions")
}

model Category {
  id                  String                @id @default(uuid())
  slug                String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  subcategories       Category[]            @relation("CategoryToSubcategory")
  parentCategory      Category?             @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  parentCategoryId    String?
  CategoryTranslation CategoryTranslation[]

  @@index([slug])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(uuid())
  locale      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_translations")
}
