// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

model User {
  id             Int                   @id @default(autoincrement())
  email          String                @unique
  emailVerified  Boolean               @default(false)
  hashedPassword String?
  firstName      String?
  lastName       String?
  avatar         String?
  role           Role                  @default(USER)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  Session        RefreshTokenSession[]

  @@index([email])
  @@map("users")
}

model RefreshTokenSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blacklisted Boolean  @default(false)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, blacklisted, expiresAt])
  @@index([token])
  @@map("refresh_token_sessions")
}

model Category {
  id                  Int                   @id @default(autoincrement())
  slug                String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  subcategories       Category[]            @relation("CategoryToSubcategory")
  parentCategory      Category?             @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  parentCategoryId    Int?
  CategoryTranslation CategoryTranslation[]
  Products            Product[]
  isPublic            Boolean               @default(true)

  @@index([slug])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  locale      String
  name        String
  description String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id                  Int                  @id @default(autoincrement())
  slug                String               @unique
  Category            Category?            @relation(fields: [categoryId], references: [id])
  categoryId          Int?
  isPublic            Boolean              @default(true)
  ProductVariants     ProductVariant[]
  Images              ProductImage[]
  ProductTranslations ProductTranslation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("products")
}

model ProductTranslation {
  id              Int     @id @default(autoincrement())
  locale          String
  Product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       Int
  name            String
  description     String? @db.LongText
  markdownContent String? @db.LongText

  @@unique([productId, locale])
  @@fulltext([description, markdownContent])
  @@map("product_translations")
}

model ProductVariant {
  id           Int            @id @default(autoincrement())
  sku          String         @unique
  stock        Int
  priceInCents Int
  Attributes   Attribute[]
  Product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  Images       ProductImage[]
  productId    Int
  isPublic     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("product_variants")
}

model ProductImage {
  id               Int             @id @default(autoincrement())
  base64           String          @db.LongText
  mimeType         String
  isThumbnail      Boolean         @default(false)
  Product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        Int?
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productVariantId Int?

  @@index([id, productId])
  @@index([id, productVariantId])
  @@map("product_images")
}

model Attribute {
  id                    Int                    @id @default(autoincrement())
  value                 String
  AttributeKey          AttributeKey           @relation(fields: [attributeKeyId], references: [id], onDelete: Cascade)
  attributeKeyId        Int
  ProductVariants       ProductVariant[]
  AttributeTranslations AttributeTranslation[]

  @@unique([value, attributeKeyId])
  @@map("attributes")
}

model AttributeTranslation {
  id          Int       @id @default(autoincrement())
  value       String
  locale      String
  Attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId Int
}

model AttributeKey {
  id           Int                       @id @default(autoincrement())
  key          String                    @unique
  Attributes   Attribute[]
  Translations AttributeKeyTranslation[]

  @@map("attribute_keys")
}

model AttributeKeyTranslation {
  id             Int          @id @default(autoincrement())
  keyTranslation String
  locale         String
  attributeKey   AttributeKey @relation(fields: [attributeKeyId], references: [id], onDelete: Cascade)
  attributeKeyId Int

  @@index([locale, attributeKeyId])
}
