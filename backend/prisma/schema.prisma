// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id             Int                   @id @default(autoincrement())
  email          String                @unique
  hashedPassword String?
  firstName      String
  lastName       String
  avatar         String?
  role           Role                  @default(USER)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  Session        RefreshTokenSession[]
  Cart           Cart?
  orders         Order[]
  LLMTasks       LLMTask[]
  UserAvatar     UserAvatar?

  @@index([email])
  @@map("users")
}

model UserAvatar {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  base64   String @db.LongText
  mimeType String

  @@index([userId])
  @@map("user_avatars")
}

model RefreshTokenSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blacklisted Boolean  @default(false)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, blacklisted, expiresAt])
  @@index([token])
  @@map("refresh_token_sessions")
}

model Category {
  id                  Int                   @id @default(autoincrement())
  slug                String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  subcategories       Category[]            @relation("CategoryToSubcategory")
  parentCategory      Category?             @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id])
  parentCategoryId    Int?
  CategoryTranslation CategoryTranslation[]
  Products            Product[]
  isPublic            Boolean               @default(true)

  @@index([slug])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  locale      String
  name        String
  description String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id                    Int                           @id @default(autoincrement())
  slug                  String                        @unique
  Category              Category?                     @relation(fields: [categoryId], references: [id])
  categoryId            Int?
  isPublic              Boolean                       @default(true)
  ProductVariants       ProductVariant[]
  Images                ProductImage[]
  ProductTranslations   ProductTranslation[]
  EmbeddingTasks        EmbeddingTask[]
  ContentEmbeddingTasks ProductContentEmbeddingTask[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  llmuserPromptResponse LLMUserPromptResponse[]

  @@map("products")
}

model ProductTranslation {
  id              Int     @id @default(autoincrement())
  locale          String
  Product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       Int
  name            String
  description     String? @db.LongText
  markdownContent String? @db.LongText

  @@unique([productId, locale])
  @@fulltext([description, markdownContent])
  @@map("product_translations")
}

model ProductVariant {
  id           Int            @id @default(autoincrement())
  sku          String         @unique
  stock        Int
  priceInCents Int
  Attributes   Attribute[]
  Product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  Images       ProductImage[]
  productId    Int
  isPublic     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id               Int             @id @default(autoincrement())
  base64           String          @db.LongText
  mimeType         String
  isThumbnail      Boolean         @default(false)
  Product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        Int?
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productVariantId Int?

  @@index([id, productId])
  @@index([id, productVariantId])
  @@map("product_images")
}

model Attribute {
  id                    Int                    @id @default(autoincrement())
  value                 String
  AttributeKey          AttributeKey           @relation(fields: [attributeKeyId], references: [id], onDelete: Cascade)
  attributeKeyId        Int
  ProductVariants       ProductVariant[]
  AttributeTranslations AttributeTranslation[]

  @@unique([value, attributeKeyId])
  @@map("attributes")
}

model AttributeTranslation {
  id          Int       @id @default(autoincrement())
  value       String
  locale      String
  Attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId Int
}

model AttributeKey {
  id           Int                       @id @default(autoincrement())
  key          String                    @unique
  Attributes   Attribute[]
  Translations AttributeKeyTranslation[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@map("attribute_keys")
}

model AttributeKeyTranslation {
  id             Int          @id @default(autoincrement())
  keyTranslation String
  locale         String
  attributeKey   AttributeKey @relation(fields: [attributeKeyId], references: [id], onDelete: Cascade)
  attributeKeyId Int

  @@index([locale, attributeKeyId])
}

model CartItem {
  id               Int            @id @default(autoincrement())
  cartId           Int
  Cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId Int
  ProductVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([cartId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@map("carts")
}

model Order {
  id                    Int                   @id @default(autoincrement())
  userId                Int?
  User                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  totalInCents          Int
  status                OrderStatus           @default(PENDING)
  shippingDetails       OrderShippingDetails?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  orderItems            OrderItem[]
  StripeSessionId       String?
  StripePaymentIntentId String?

  @@index([userId])
  @@index([StripeSessionId])
  @@map("orders")
}

model OrderShippingDetails {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  Order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  state      String?
  postalCode String
  country    String
  city       String?
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@map("order_shipping_details")
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  orderId          Int
  Order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId Int?
  sku              String
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  quantity         Int             @default(1)
  unitPriceInCents Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  FAILED
}

model EmbeddingTask {
  id        Int                 @id @default(autoincrement())
  productId Int
  Product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  status    EmbeddingTaskStatus @default(PENDING)
  lang      String
  createdAt DateTime            @default(now())

  @@unique([productId, lang])
  @@index([productId, lang])
}

model ProductContentEmbeddingTask {
  id        Int                 @id @default(autoincrement())
  productId Int
  Product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  status    EmbeddingTaskStatus @default(PENDING)
  lang      String
  createdAt DateTime            @default(now())

  @@unique([productId, lang])
  @@index([productId, lang])
}

enum EmbeddingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model LLMTask {
  id       Int                    @id @default(autoincrement())
  userId   Int
  User     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt   String                 @db.LongText
  response LLMUserPromptResponse?
  status   LLMTaskStatus          @default(PENDING)
  date     DateTime               @default(now())
  lang     String

  @@index([userId])
  @@index([userId, date])
  @@map("llm_tasks")
}

model LLMUserPromptResponse {
  id        Int       @id @default(autoincrement())
  llmTaskId Int       @unique
  LLMTask   LLMTask   @relation(fields: [llmTaskId], references: [id], onDelete: Cascade)
  text      String    @db.LongText
  products  Product[]

  @@index([llmTaskId])
  @@map("llm_user_prompt_responses")
}

enum LLMTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
